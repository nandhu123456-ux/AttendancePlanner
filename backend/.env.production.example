# Production environment template (for Render / Docker Compose / VPS).
# Copy relevant values into Render's dashboard or your compose env.
# NEVER commit real values or the local backend/.env.

# ---- Mandatory (no safe default) ----
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
SECRET_KEY=replace-with-a-long-random-jwt-secret-64-chars
CREDENTIAL_ENCRYPTION_KEY=replace-with-fernet-key

# ---- Optional (have safe defaults) ----
DATABASE_NAME=attendance_planner
TOKEN_EXPIRE_HOURS=8
MAX_CUSTOM_ADJUSTMENTS_PER_MONTH=4
PLANNER_CAMPUS=BLR
PLANNER_TIMEZONE=Asia/Kolkata

# ---- Only needed if you keep the frontend on a DIFFERENT origin than the API ----
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=

# ---- Tells the backend where the built frontend lives (default already correct) ----
# FRONTEND_DIST=/frontend/dist